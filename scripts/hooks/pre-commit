#!/bin/sh
# Runs the checks for what is staged: the app's `npm run check` (lint, typecheck, tests) when app files are staged,
# the eval set's ruff + pytest when Dataset/ files are. Enabled per clone with `git config core.hooksPath scripts/hooks`.
# Commit without it once with `git commit --no-verify`.
# Each check's output goes to a temporary log, printed only when the check fails: a passing commit prints one line per
# check, not the 100+ test names that filled agents' context.
root=$(git rev-parse --show-toplevel)
staged=$(git diff --cached --name-only --diff-filter=ACMR)
log=$(mktemp)
trap 'rm -f "$log"' EXIT

# run <name> <command…>: the command's output kept in $log; on failure printed with the name, and the hook stops.
run() {
  name=$1
  shift
  if "$@" >"$log" 2>&1; then
    echo "pre-commit: $name passed"
  else
    cat "$log" >&2
    echo "pre-commit: $name FAILED (output above; commit without the hook: git commit --no-verify)" >&2
    exit 1
  fi
}

if echo "$staged" | grep -qE '^(src/|scripts/|prisma/|package(-lock)?\.json$|tsconfig\.json$|eslint\.config\.mjs$|Dataset/tests/fixtures/[^/]*\.ts$)'; then
  run "app (npm run check)" sh -c "cd '$root' && npm run --silent check"
fi

if echo "$staged" | grep -q '^Dataset/'; then
  py="$root/Dataset/.venv/Scripts/python.exe"
  [ -x "$py" ] || py="$root/Dataset/.venv/bin/python"
  if [ ! -x "$py" ]; then
    echo "pre-commit: no Dataset/.venv in this checkout; set it up as docs/agents/eval-project.md says" >&2
    exit 1
  fi
  run "eval set (ruff)" sh -c "cd '$root/Dataset' && '$py' -m ruff check ."
  run "eval set (pytest)" sh -c "cd '$root/Dataset' && '$py' -m pytest -q -p no:warnings"
fi

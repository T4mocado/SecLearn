flowchart LR
  subgraph BI["(a) Bi-encoder"]
    direction TB
    BQ["Câu hỏi"] --> BE1["Bộ mã hóa"]
    BD["Đoạn văn"] --> BE2["Bộ mã hóa<br/>(chạy trước, lưu lại)"]

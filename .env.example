DATABASE_URL="postgresql://seclearn:seclearn@localhost:5432/seclearn?schema=public"
AUTH_SECRET="replace-with-long-random-string"
AUTH_URL="http://localhost:3847"

# Chat LLM — product default: deepseek (mock only for smoke without keys)
LLM_PROVIDER="deepseek"
# LLM_PROVIDER: mock | openai | deepseek
DEEPSEEK_API_KEY=""
OPENAI_API_KEY=""
# DeepSeek official default: deepseek-flash (override anytime)
LLM_MODEL="deepseek-flash"
# OpenAI example: gpt-4o-mini

# Embeddings — product default (option A): OpenAI text-embedding-3-small (dim 1536)
EMBED_PROVIDER="huggingface"
# EMBED_PROVIDER: openai | mock | local | huggingface
EMBED_MODEL="bkai-foundation-models/vietnamese-bi-encoder"
# Must match Prisma vector(N). BKAI = 768, OpenAI = 1536, local MiniLM = 384.
EMBED_DIM="768"
HF_TOKEN=""
# Only needed for EMBED_PROVIDER=local (ONNX weight cache; first embed downloads model)
# TRANSFORMERS_CACHE="./.cache/transformers"

ADMIN_EMAIL="admin@seclearn.local"
ADMIN_PASSWORD="change-me"
UPLOAD_DIR="./data/uploads"
GUEST_QUESTION_LIMIT="10"
RAG_TOP_K="5"
# Cross-encoder reranker served by scripts/embed_server.py (BAAI/bge-reranker-v2-m3). Empty = cosine only.
RERANK_URL="http://127.0.0.1:8008/rerank"
# Candidates fetched for reranking, and the 0..1 relevance below which a chunk is dropped
# (keep low: Vietnamese question vs English chunk scores ~0.01-0.05 even when relevant)
RAG_CANDIDATES="20"
RAG_MIN_RELEVANCE="0.01"
# Keep at least this many chunks when at least one passes the threshold (0 = threshold only)
RAG_MIN_KEEP="2"
# Also search with an English translation of a non-English question (~100 tokens per question). on | off
RAG_TRANSLATE_QUERY="on"
# After each answer, the chat LLM scores every chunk (relevance to question, contribution to answer). on | off
RAG_JUDGE="on"
CHUNK_SIZE="800"
# Documents ingested in parallel / chunks per embedding request
INGEST_CONCURRENCY="2"
EMBED_BATCH_SIZE="32"
CHUNK_OVERLAP="80"
NEXT_PUBLIC_APP_URL="http://localhost:3847"
